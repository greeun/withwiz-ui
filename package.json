{
  "name": "@withwiz/ui",
  "version": "0.5.1",
  "description": "UI components for withwiz projects, namespaced by platform (@withwiz/ui/<platform>/*). React is the first supported platform.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./react/components/ui/*": "./dist/react/components/ui/*.js",
    "./react/components/ui/data-table": "./dist/react/components/ui/data-table/index.js",
    "./react/components/ui/data-table/*": "./dist/react/components/ui/data-table/*.js",
    "./react/components/ui/data-table/DataTable": "./dist/react/components/ui/data-table/DataTable.js",
    "./react/components/ui/data-table/DataTableBody": "./dist/react/components/ui/data-table/DataTableBody.js",
    "./react/components/ui/data-table/DataTableBulkActions": "./dist/react/components/ui/data-table/DataTableBulkActions.js",
    "./react/components/ui/data-table/DataTableFilters": "./dist/react/components/ui/data-table/DataTableFilters.js",
    "./react/components/ui/data-table/DataTablePageSize": "./dist/react/components/ui/data-table/DataTablePageSize.js",
    "./react/components/ui/data-table/DataTablePagination": "./dist/react/components/ui/data-table/DataTablePagination.js",
    "./react/components/ui/data-table/DataTableSearch": "./dist/react/components/ui/data-table/DataTableSearch.js",
    "./react/components/ui/data-table/types": "./dist/react/components/ui/data-table/types.js",
    "./react/error": "./dist/react/error/index.js",
    "./react/error/error-display": "./dist/react/error/error-display.js",
    "./react/hooks/useDataTable": "./dist/react/hooks/useDataTable.js",
    "./react/hooks/useDebounce": "./dist/react/hooks/useDebounce.js",
    "./react/hooks/useExitIntent": "./dist/react/hooks/useExitIntent.js",
    "./react/hooks/useMediaQuery": "./dist/react/hooks/useMediaQuery.js",
    "./react/hooks/useTimezone": "./dist/react/hooks/useTimezone.js",
    "./react/primitives/*": "./dist/react/primitives/*.js",
    "./react/utils/client-utils": "./dist/react/utils/client-utils.js",
    "./react/utils/qr-code": "./dist/react/utils/qr-code.js"
  },
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --skipLibCheck",
    "build:js": "tsup",
    "build:types": "tsc --emitDeclarationOnly --skipLibCheck",
    "prepublishOnly": "rm -rf dist && pnpm run build && pnpm test",
    "test": "vitest run -c vitest.config.ts",
    "test:watch": "vitest -c vitest.config.ts"
  },
  "peerDependencies": {
    "@withwiz/toolkit": ">=0.8.0",
    "next": ">=15",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "@withwiz/toolkit": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@radix-ui/react-visually-hidden": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react-hook-form": "^7.81.0",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@withwiz/toolkit": "^0.8.0",
    "jsdom": "^25.0.0",
    "next": "^16.3.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "ui",
    "react",
    "datatable",
    "withwiz",
    "shadcn",
    "radix"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeun/withwiz-ui.git"
  },
  "homepage": "https://github.com/greeun/withwiz-ui#readme",
  "bugs": {
    "url": "https://github.com/greeun/withwiz-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
