{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@withwiz/ui/*": ["./src/*"]
    }
  },
  "include": ["src/react/**/*.ts", "src/react/**/*.tsx"],
  "exclude": ["node_modules", "dist", "__tests__", "tsup.config.ts", "vitest.config.ts"]
}
